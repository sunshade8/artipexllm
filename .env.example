# EmpathyArtRAG Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key (Required for chat functionality)
OPENAI_API_KEY=your-openai-api-key-here

# Tavily API Key (Optional for web search functionality)
TAVILY_API_KEY=your-tavily-api-key-here

# Art Data Paths (Optional, defaults are set in config.py)
# ART_CSV_PATH=/path/to/your/painting_info_with_descriptions.csv
# ART_IMAGE_FOLDER=/path/to/your/artwork/images 